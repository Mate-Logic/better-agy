{
  "$schema": "https://antigravity.google/schemas/v1/plugin.json",
  "name": "handoff",
  "displayName": "Handoff",
  "version": "0.1.0",
  "description": "Type /handoff before you close a session and the agent writes down where things stand, so the next session, or a teammate, picks up in one prompt.",
  "suggestedPrompts": [
    "Write a handoff for this session",
    "Continue from the last handoff"
  ],
  "author": {
    "name": "MateLogic",
    "url": "https://mate-logic.tech/"
  },
  "homepage": "https://github.com/Mate-Logic/betterantigravity/tree/main/plugins/handoff",
  "repository": "https://github.com/Mate-Logic/betterantigravity",
  "license": "MIT",
  "keywords": [
    "handoff",
    "session",
    "notes",
    "context"
  ]
}
