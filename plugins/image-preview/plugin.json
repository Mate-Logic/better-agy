  },
  "homepage": "https://github.com/Mate-Logic/better-agy/tree/main/plugins/image-preview",
  "repository": "https://github.com/Mate-Logic/better-agy",
  "license": "MIT",
  "keywords": [
    "image",
    "preview",
    "ghostty",
    "kitty"
  ]
}
