{
  "$schema": "https://antigravity.google/schemas/v1/plugin.json",
  "name": "quick-peek",
  "displayName": "Quick Peek",
  "version": "0.2.2",
  "description": "Preview files and directories with line numbers using /peek, or reveal any path in your system file manager.",
  "suggestedPrompts": [
    "/peek src/site.ts",
    "/peek plugins --open"
  ],
  "author": {
    "name": "MateLogic (adapted from midudev/better-claude)",
    "url": "https://mate-logic.tech/"
  },
  "homepage": "https://github.com/Mate-Logic/betterantigravity/tree/main/plugins/quick-peek",
  "repository": "https://github.com/Mate-Logic/betterantigravity",
  "license": "MIT",
  "keywords": [
    "peek",
    "preview",
    "files",
    "explorer"
  ]
}
