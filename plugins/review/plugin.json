{
  "$schema": "https://antigravity.google/schemas/v1/plugin.json",
  "name": "review",
  "displayName": "Review",
  "version": "0.1.0",
  "description": "Type /review and the agent reads your diff like a strict reviewer: real bugs first, each with the file, the line and the input that breaks it.",
