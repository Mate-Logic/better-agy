  },
  "homepage": "https://github.com/Mate-Logic/better-agy/tree/main/plugins/review",
  "repository": "https://github.com/Mate-Logic/better-agy",
  "license": "MIT",
  "keywords": [
    "review",
    "code-review",
    "bugs"
  ]
}
