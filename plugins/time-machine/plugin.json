{
  "$schema": "https://antigravity.google/schemas/v1/plugin.json",
  "name": "time-machine",
  "displayName": "Time Machine",
  "version": "0.1.3",
  "description": "Automatic git working-tree snapshots per turn. Use /timeline to inspect history, diff states, and undo or redo changes safely.",
  "suggestedPrompts": [
    "/timeline",
    "/timeline undo"
  ],
  "author": {
    "name": "MateLogic (adapted from DiegoMarty & midudev/better-claude)",
    "url": "https://mate-logic.tech/"
  },
  "homepage": "https://github.com/Mate-Logic/betterantigravity/tree/main/plugins/time-machine",
  "repository": "https://github.com/Mate-Logic/betterantigravity",
  "license": "MIT",
  "keywords": [
    "git",
    "timeline",
    "undo",
    "snapshot",
    "time-machine"
  ]
}
